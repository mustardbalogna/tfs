# Supabase (message storage) — from Project Settings > API
SUPABASE_URL=
# Newer Supabase projects call this "Secret key" (SUPABASE_SECRET_KEY) instead
# of "service_role" — either env var name works, whichever your project has.
SUPABASE_SERVICE_ROLE_KEY=

# Resend (owner notification email) — from resend.com/api-keys
RESEND_API_KEY=
RESEND_FROM_EMAIL=
OWNER_NOTIFICATION_EMAIL=

# Admin dashboard login
ADMIN_PASSWORD=
# Random long string used to sign admin session cookies, e.g. `openssl rand -hex 32`
SESSION_SECRET=
